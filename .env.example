# Copy this file to .env and fill in real values. Never commit .env.
PORT=5000
NODE_ENV=development

# SQLite file path (built into Node itself via node:sqlite - no separate
# database server needed for dev). For production behind a host that wipes
# the filesystem on deploy (e.g. most serverless platforms), point this at
# a persistent disk/volume path, or swap the src/db layer for a managed
# Postgres/MySQL service instead.
DATABASE_URL="file:./data/dev.db"

# Long random string used to sign JWTs. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
